{
    "description": "Prompt for checking whether the ticket's changes will incur AI token expenses once merged, for every one of the variation's merge requests (the grouped engines, ASS-81)",
    "supported-command-line-interfaces": [
        "claude"
    ],
    "supported-models": [
        "claude-opus-5-5",
        "claude-opus-5",
        "claude-sonnet-5",
        "claude-opus-4-8",
        "claude-opus-4-7"
    ],
    "persona": "architect",
    "input-arguments": [
        {
            "name": "project",
            "description": "Project folder name under data/projects/",
            "example": "my-project",
            "required": true
        },
        {
            "name": "ticket",
            "description": "Ticket number",
            "example": "ABC-1234",
            "required": true
        },
        {
            "name": "variation",
            "description": "The ticket variation",
            "example": "A",
            "required": true
        }
    ],
    "output": {
        "type": "object",
        "properties": {
            "will-spend-tokens": {
                "type": "boolean",
                "description": "true if merging this change will cause new or increased AI token spend"
            }
        },
        "required": [
            "will-spend-tokens"
        ],
        "additionalProperties": false
    }
}
