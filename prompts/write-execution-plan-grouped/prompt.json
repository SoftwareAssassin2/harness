{
    "description": "Prompt for writing the execution plan and planning its merge requests, revising what is there already (the grouped engines, ASS-68, ASS-80)",
    "supported-command-line-interfaces": [
        "claude"
    ],
    "supported-models": [
        "claude-opus-5-5",
        "claude-opus-5",
        "claude-sonnet-5",
        "claude-opus-4-8",
        "claude-opus-4-7"
    ],
    "persona": "architect",
    "input-arguments": [
        {
            "name": "project",
            "description": "Project folder name under data/projects/",
            "example": "my-project",
            "required": true
        },
        {
            "name": "ticket",
            "description": "Ticket number",
            "example": "ABC-1234",
            "required": true
        },
        {
            "name": "variation",
            "description": "The ticket variation",
            "example": "A",
            "required": true
        }
    ],
    "output": ""
}
