{
    "description": "Prompt for capturing screenshots of the changes working, for every one of the variation's merge requests (the grouped engines, ASS-81)",
    "supported-command-line-interfaces": [
        "claude"
    ],
    "supported-models": [
        "claude-opus-5-5",
        "claude-opus-5",
        "claude-sonnet-5",
        "claude-opus-4-8",
        "claude-opus-4-7"
    ],
    "persona": "tester",
    "input-arguments": [
        {
            "name": "project",
            "description": "Project folder name under data/projects/",
            "example": "my-project",
            "required": true
        },
        {
            "name": "ticket",
            "description": "Ticket number",
            "example": "ABC-1234",
            "required": true
        },
        {
            "name": "variation",
            "description": "The ticket variation",
            "example": "A",
            "required": true
        }
    ],
    "output": {
        "type": "object",
        "properties": {
            "screenshots": {
                "type": "array",
                "description": "One per acceptance criterion with a visible result",
                "items": {
                    "type": "object",
                    "properties": {
                        "file": {
                            "type": "string",
                            "description": "The file name under the ticket folder's screenshots/"
                        },
                        "criteria-number": {
                            "type": "integer",
                            "description": "The acceptance criterion it shows"
                        },
                        "shows": {
                            "type": "string",
                            "description": "One line: what the screenshot shows"
                        }
                    },
                    "required": [
                        "file",
                        "criteria-number",
                        "shows"
                    ],
                    "additionalProperties": false
                }
            },
            "note": {
                "type": "string",
                "description": "One line: why nothing could be captured, when the list is empty for that reason"
            }
        },
        "required": [
            "screenshots"
        ],
        "additionalProperties": false
    }
}
