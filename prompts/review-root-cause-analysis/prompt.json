{
    "description": "Prompt for reviewing the root cause analysis",
    "supported-command-line-interfaces": [
        "claude"
    ],
    "supported-models": [
        "claude-opus-5-5",
        "claude-opus-5",
        "claude-sonnet-5",
        "claude-opus-4-8",
        "claude-opus-4-7"
    ],
    "persona": "architect",
    "input-arguments": [
        {
            "name": "ticket",
            "description": "Ticket number",
            "example": "ABC-1234",
            "required": true
        }
    ],
    "output": {
        "type": "object",
        "properties": {
            "is-approved": {
                "type": "boolean",
                "description": "true if the root cause analysis is approved; false sends it back for rework"
            }
        },
        "required": [
            "is-approved"
        ],
        "additionalProperties": false
    }
}
