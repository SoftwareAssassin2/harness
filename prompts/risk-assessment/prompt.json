{
    "description": "Prompt for assessing the merge request's risk",
    "supported-command-line-interfaces": [
        "claude"
    ],
    "supported-models": [
        "claude-opus-5-5",
        "claude-opus-5",
        "claude-sonnet-5",
        "claude-opus-4-8",
        "claude-opus-4-7"
    ],
    "persona": "architect",
    "input-arguments": [
        {
            "name": "ticket",
            "description": "Ticket number",
            "example": "ABC-1234",
            "required": true
        }
    ],
    "output": {
        "type": "object",
        "properties": {
            "flagged-for-human-review": {
                "type": "boolean",
                "description": "true if the merge request is risky enough to need a human review"
            }
        },
        "required": [
            "flagged-for-human-review"
        ],
        "additionalProperties": false
    }
}
