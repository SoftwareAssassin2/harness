{
    "description": "Prompt for writing steps-to-test-{variation}.md and posting it as a ticket comment (the grouped engines, in the variation's VM: posted through agent.sh on stdin, ASS-182)",
    "supported-command-line-interfaces": [
        "claude"
    ],
    "supported-models": [
        "claude-opus-5-5",
        "claude-opus-5",
        "claude-sonnet-5",
        "claude-opus-4-8",
        "claude-opus-4-7"
    ],
    "persona": "developer",
    "input-arguments": [
        {
            "name": "project",
            "description": "Project folder name under data/projects/",
            "example": "my-project",
            "required": true
        },
        {
            "name": "ticket",
            "description": "Ticket number",
            "example": "ABC-1234",
            "required": true
        }
    ],
    "output": ""
}
