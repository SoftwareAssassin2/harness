{
    "steps": [

        { "id": "inspect-ticket", "sequence": 1, "name": "Inspect Ticket", "description": "Checking the ticket's folder, branch, worktree, merge request and state history",
            "action": { "type": "prompt", "prompt": "check-ticket-health", "agent-count": 1, "run-in-dev-container": false },
            "exit-events": [
                { "condition": { "all": [ { "turn-complete": true }, { "structured-output": { "is-healthy": true } } ] }, "move-to-state": "done" },
                { "condition": { "all": [ { "turn-complete": true }, { "structured-output": { "is-healthy": false } } ] }, "move-to-state": "classify" }
            ]
        },
        { "id": "classify", "sequence": 2, "name": "Classify", "description": "A harness, project or environment issue, with its reasoning, as Blocked classifies (ASS-107 AC4): a harness or environment issue's ticket goes to the harness project's backlog, a project issue's to the sampled ticket's own project's ticket system",
            "action": { "type": "prompt", "prompt": "classify-issue", "agent-count": 1, "run-in-dev-container": false },
            "exit-events": [
                { "condition": { "all": [ { "turn-complete": true }, { "structured-output": { "issue": "harness" } } ] }, "move-to-state": "create-ticket" },
                { "condition": { "all": [ { "turn-complete": true }, { "structured-output": { "issue": "project" } } ] }, "move-to-state": "create-ticket" },
                { "condition": { "all": [ { "turn-complete": true }, { "structured-output": { "issue": "environment" } } ] }, "move-to-state": "create-ticket" }
            ]
        },
        { "id": "create-ticket", "sequence": 3, "name": "Create Ticket", "description": "Raising a ticket for the problem found, where Classify said (facts.js fixTicketIn)",
            "action": { "type": "state-engine", "engine": "create-ticket" },
            "exit-events": [
                { "condition": { "is-done": true }, "move-to-state": "done" }
            ]
        },

        { "id": "done", "sequence": 4, "name": "Done", "description": "Ticket health check is completed", "is-done": true,
            "action": { "type": "none" }
        }
    ]
}
