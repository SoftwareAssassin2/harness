{
    "steps": [
        {
            "id": "refresh-repositories",
            "sequence": 1,
            "name": "Refresh the Reference Repositories",
            "description": "Bring the repositories the ticket does not change up to their default branch, so the work is built against current upstream",
            "action": {
                "type": "script",
                "command": "./agent.sh vm:refresh-repositories {project} {ticket} {variation}"
            },
            "exit-events": [
                {
                    "condition": {
                        "exit-code": 0
                    },
                    "move-to-state": "generate-automated-tests"
                },
                {
                    "condition": {
                        "not": {
                            "exit-code": 0
                        }
                    },
                    "move-to-state": "blocked"
                }
            ]
        },
        {
            "id": "generate-automated-tests",
            "sequence": 2,
            "name": "Generate Automated Tests",
            "description": "Generating the tests",
            "max-visits": 3,
            "on-max-visits": "blocked",
            "action": {
                "type": "prompt",
                "prompt": "generate-automated-tests-grouped",
                "agent-count": 1,
                "run-in-dev-container": false
            },
            "exit-events": [
                {
                    "condition": {
                        "all": [
                            {
                                "turn-complete": true
                            },
                            {
                                "script-succeeds": "./agent.sh automated-tests:verify-exist-and-runnable {project} {ticket} {variation}"
                            }
                        ]
                    },
                    "move-to-state": "generate-solution"
                },
                {
                    "condition": {
                        "all": [
                            {
                                "turn-complete": true
                            },
                            {
                                "not": {
                                    "script-succeeds": "./agent.sh automated-tests:verify-exist-and-runnable {project} {ticket} {variation}"
                                }
                            }
                        ]
                    },
                    "move-to-state": "generate-automated-tests"
                }
            ],
            "run-location": "vm"
        },
        {
            "id": "generate-solution",
            "sequence": 3,
            "name": "Generate Solution",
            "description": "Generating the solution",
            "max-visits": 5,
            "on-max-visits": "blocked",
            "action": {
                "type": "prompt",
                "prompt": "generate-solution-grouped",
                "agent-count": 1,
                "run-in-dev-container": true
            },
            "exit-events": [
                {
                    "condition": {
                        "turn-complete": true
                    },
                    "move-to-state": "await-dependencies"
                }
            ],
            "run-location": "vm"
        },
        {
            "id": "address-merge-request-feedback",
            "sequence": 4,
            "name": "Address Merge Request Feedback",
            "description": "Act on the review threads, plain review comments, failed pipeline or needed rebase of the ticket's own merge request that another of its merge requests waits on at Await Sequential Merge (its exit 4), then wait again; Release's own Address Merge Request Feedback comes after the very tests that wait (ASS-361)",
            "max-visits": 3,
            "on-max-visits": "blocked",
            "action": {
                "type": "prompt",
                "prompt": "check-on-merge-request-build-grouped",
                "agent-count": 1,
                "run-in-dev-container": true
            },
            "exit-events": [
                {
                    "condition": {
                        "turn-complete": true
                    },
                    "move-to-state": "await-dependencies"
                }
            ],
            "run-location": "vm"
        },
        {
            "id": "merge-awaited",
            "sequence": 5,
            "name": "Merge the Awaited",
            "shows-merge-train": true,
            "description": "Only from Await Sequential Merge's exit 5, where a step of the variation's status chain says merges-awaited: true (ASS-365): grouped-merge, the merge loop, over the merge requests waited on (its merge-request-ids) — Code Review and Security Review at their head commits, out of draft, Address Merge Request Feedback, auto-merge — until they are merged, then back to Await Sequential Merge. Merged here, the awaited merge request merges before the ticket's Test, Document, Review and Human Review",
            "max-visits": 5,
            "on-max-visits": "blocked",
            "pass-output": [
                "merge-request-ids"
            ],
            "action": {
                "type": "state-engine",
                "engine": "grouped-merge"
            },
            "exit-events": [
                {
                    "condition": {
                        "all": [
                            {
                                "is-done": true
                            },
                            {
                                "sub-engine-ended-at": "blocked"
                            }
                        ]
                    },
                    "move-to-state": "blocked"
                },
                {
                    "condition": {
                        "all": [
                            {
                                "is-done": true
                            },
                            {
                                "sub-engine-ended-at": "blocked-for-human"
                            }
                        ]
                    },
                    "move-to-state": "blocked-for-human"
                },
                {
                    "condition": {
                        "all": [
                            {
                                "is-done": true
                            },
                            {
                                "sub-engine-ended-at": "rebuild"
                            }
                        ]
                    },
                    "move-to-state": "generate-solution"
                },
                {
                    "condition": {
                        "is-done": true
                    },
                    "move-to-state": "await-dependencies"
                }
            ]
        },
        {
            "id": "await-dependencies",
            "sequence": 6,
            "name": "Await Sequential Merge",
            "shows-merge-train": true,
            "description": "Wait until every merge request a merge request of the ticket depends on in another repository is merged, so its tests do not run against what that repository has not yet published; polling while one is not (exit 2, its waiting-exit-code: no failure, ASS-335); nothing to wait for passes at once. What each dependency needs (draft, failed pipeline, open threads, rebase, approval) is the operator's feedback, written when it changes; one of the ticket's own planned merge requests never created is not waited on but sent back to Generate Solution (exit 3, under its max-visits) (ASS-359). One with review threads, review comments, a failed pipeline or a needed rebase of its own goes to Address Merge Request Feedback (exit 4, under its max-visits) (ASS-361); a draft or an approval alone keeps polling. Where the project's workflow opts in (merges-awaited: true on a step of the variation's status chain, read by control) and the ticket has one variation in play, one awaited with nothing of its own to act on — a draft, an approval, or the merge itself — goes to Merge the Awaited (exit 5) (ASS-365)",
            "record-script-output": true,
            "action": {
                "type": "script",
                "command": "./agent.sh merge-request:await-dependencies {project} {ticket} {variation}",
                "mode": "timer",
                "timer-minutes": 5,
                "waiting-exit-code": 2
            },
            "exit-events": [
                {
                    "condition": {
                        "exit-code": 0
                    },
                    "move-to-state": "refresh-before-testing"
                },
                {
                    "condition": {
                        "exit-code": 3
                    },
                    "move-to-state": "generate-solution"
                },
                {
                    "condition": {
                        "exit-code": 4
                    },
                    "move-to-state": "address-merge-request-feedback"
                },
                {
                    "condition": {
                        "exit-code": 5
                    },
                    "move-to-state": "merge-awaited"
                }
            ]
        },
        {
            "id": "refresh-before-testing",
            "sequence": 7,
            "name": "Refresh the Reference Repositories Before Testing",
            "description": "Bring the repositories the ticket does not change up to their default branch again, so the tests run against current upstream",
            "action": {
                "type": "script",
                "command": "./agent.sh vm:refresh-repositories {project} {ticket} {variation}"
            },
            "exit-events": [
                {
                    "condition": {
                        "exit-code": 0
                    },
                    "move-to-state": "check-numbered-files"
                },
                {
                    "condition": {
                        "not": {
                            "exit-code": 0
                        }
                    },
                    "move-to-state": "blocked"
                }
            ]
        },
        {
            "id": "check-numbered-files",
            "sequence": 8,
            "name": "Check Numbered Files",
            "description": "Each numbered file (a migration, a numbered test) the ticket's merge requests add must be above the highest on its target branch and taken by no older open merge request in its repository, by project.json's numbered-files (ASS-385): on the host, its checkouts read in the VM, the other open merge requests from the forge. One that is not goes back to Generate Solution (exit 1) with each file and the free number to use. A forge or VM call that fails is tried 3 times in the command; still failing, the step waits (exit 2, its waiting-exit-code: polled every 5 minutes, no visit or failure counted, the variation's feedback saying what it can't reach) for up to 30 minutes since it was entered, then ends Build at Blocked (exit 3, its feedback naming what kept failing and its last error), as a check that could not run at all (a malformed declaration, no VM) does at once (ASS-386). Any other exit matches none: tried again",
            "max-visits": 3,
            "on-max-visits": "blocked",
            "record-script-output": true,
            "action": {
                "type": "script",
                "command": "./agent.sh merge-request:check-numbered-files {project} {ticket} {variation}",
                "mode": "timer",
                "timer-minutes": 5,
                "waiting-exit-code": 2
            },
            "exit-events": [
                {
                    "condition": {
                        "exit-code": 0
                    },
                    "move-to-state": "automated-testing"
                },
                {
                    "condition": {
                        "exit-code": 3
                    },
                    "move-to-state": "blocked"
                },
                {
                    "condition": {
                        "exit-code": 1
                    },
                    "move-to-state": "generate-solution"
                }
            ]
        },
        {
            "id": "automated-testing",
            "sequence": 9,
            "name": "Automated Testing",
            "description": "Run automated tests",
            "max-visits": 3,
            "on-max-visits": "blocked",
            "action": {
                "type": "script",
                "command": "./agent.sh automated-tests:verify-success {project} {ticket} {variation}"
            },
            "exit-events": [
                {
                    "condition": {
                        "exit-code": 0
                    },
                    "move-to-state": "ci-checks"
                },
                {
                    "condition": {
                        "exit-code": 3
                    },
                    "move-to-state": "blocked"
                },
                {
                    "condition": {
                        "exit-code": 4
                    },
                    "move-to-state": "generate-automated-tests"
                },
                {
                    "condition": {
                        "not": {
                            "exit-code": 0
                        }
                    },
                    "move-to-state": "generate-solution"
                }
            ],
            "run-location": "vm"
        },
        {
            "id": "ci-checks",
            "sequence": 10,
            "name": "CI Checks",
            "description": "Run the merge-request CI checks the project declares (ci-checks.json) for each repository the ticket changes; a project that declares none passes with nothing run",
            "max-visits": 3,
            "on-max-visits": "blocked",
            "action": {
                "type": "script",
                "command": "./agent.sh ci-checks:verify {project} {ticket} {variation}"
            },
            "exit-events": [
                {
                    "condition": {
                        "exit-code": 0
                    },
                    "move-to-state": "code-review"
                },
                {
                    "condition": {
                        "exit-code": 3
                    },
                    "move-to-state": "blocked"
                },
                {
                    "condition": {
                        "not": {
                            "exit-code": 0
                        }
                    },
                    "move-to-state": "generate-solution"
                }
            ],
            "run-location": "vm"
        },
        {
            "id": "code-review",
            "sequence": 11,
            "name": "Code Review",
            "description": "Reviewing the solution",
            "max-visits": 3,
            "on-max-visits": "blocked",
            "action": {
                "type": "prompt",
                "prompt": "code-review-grouped",
                "agent-count": 1,
                "run-in-dev-container": false
            },
            "exit-events": [
                {
                    "condition": {
                        "all": [
                            {
                                "turn-complete": true
                            },
                            {
                                "structured-output": {
                                    "is-approved": true
                                }
                            }
                        ]
                    },
                    "move-to-state": "security-review"
                },
                {
                    "condition": {
                        "all": [
                            {
                                "turn-complete": true
                            },
                            {
                                "structured-output": {
                                    "is-approved": false
                                }
                            }
                        ]
                    },
                    "move-to-state": "generate-solution"
                }
            ],
            "run-location": "vm"
        },
        {
            "id": "security-review",
            "sequence": 12,
            "name": "Security Review",
            "description": "Security review",
            "max-visits": 3,
            "on-max-visits": "blocked",
            "action": {
                "type": "prompt",
                "prompt": "security-review-grouped",
                "agent-count": 1,
                "run-in-dev-container": false
            },
            "exit-events": [
                {
                    "condition": {
                        "all": [
                            {
                                "turn-complete": true
                            },
                            {
                                "structured-output": {
                                    "is-approved": true
                                }
                            }
                        ]
                    },
                    "move-to-state": "done"
                },
                {
                    "condition": {
                        "all": [
                            {
                                "turn-complete": true
                            },
                            {
                                "structured-output": {
                                    "is-approved": false
                                }
                            }
                        ]
                    },
                    "move-to-state": "generate-solution"
                }
            ],
            "run-location": "vm"
        },
        {
            "id": "done",
            "name": "Done",
            "description": "The group is finished; its parent step moves on",
            "is-done": true,
            "action": {
                "type": "none"
            },
            "sequence": 13
        },
        {
            "id": "blocked",
            "name": "Blocked",
            "description": "A step failed or looped too many times; the parent step sends the ticket to Blocked, which returns it to the start of this group",
            "is-done": true,
            "action": {
                "type": "none"
            },
            "sequence": 14
        },
        {
            "id": "blocked-for-human",
            "name": "Blocked for Human",
            "description": "Only from Merge the Awaited (ASS-365): an awaited merge request's approvals have not come within approval-wait-days; the parent step, which sets merges-awaited, sends the ticket to Blocked for Human",
            "is-done": true,
            "action": {
                "type": "none"
            },
            "sequence": 15
        }
    ]
}
