                                }
                            }
                        ]
                    },
                    "move-to-state": "write-test-plan"
                },
                {
                    "condition": {
                        "all": [
                            {
                                "turn-complete": true
                            },
                            {
                                "not": {
                                    "file-updated": {
                                        "file": "execution-plan.md",
                                        "since": "turn-start"
                                    }
                                }
                            }
                        ]
                    },
                    "move-to-state": "write-execution-plan"
