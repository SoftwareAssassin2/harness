                "type": "prompt",
                "prompt": "root-cause-analysis",
                "agent-count": 1,
                "run-in-dev-container": true
            },
            "exit-events": [
                {
                    "condition": {
                        "all": [
                            {
                                "turn-complete": true
                            },
                            {
                                "file-updated": {
                                    "file": "root-cause-analysis.md",
                                    "since": "turn-start"
                                }
                            }
                        ]
                    },
                    "move-to-state": "review-root-cause-analysis"
                },
                {
                    "condition": {
                        "all": [
                            {
                                "turn-complete": true
                            },
                            {
                                "not": {
                                    "file-updated": {
                                        "file": "root-cause-analysis.md",
                                        "since": "turn-start"
                                    }
                                }
                            }
                        ]
                    },
                    "move-to-state": "root-cause-analysis"
                }
            ]
        },
        {
            "id": "review-root-cause-analysis",
            "sequence": 8,
            "name": "Review Root Cause Analysis",
            "description": "Reviewing the root cause analysis",
            "paired-ticket-system-status": "In Progress",
            "is-planning-stage": true,
            "max-visits": 3,
            "on-max-visits": "blocked",
            "return-to-state": "review-root-cause-analysis",
            "action": {
                "type": "prompt",
                "prompt": "review-root-cause-analysis",
                "agent-count": 1,
