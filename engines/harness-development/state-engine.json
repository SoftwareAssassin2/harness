{
    "receive-dispatch-prompt": "receive-dispatch",
    "receive-pair-dispatch-prompt": "receive-pair-dispatch",
    "receive-message-prompt": "receive-message-from-another-agent",
    "ask-for-status-update-prompt": "ask-for-status-update",
    "ask-for-status-update-given-none-was-provided-for-seconds": 480,
    "shut-down-prompt": "shut-down",
    "check-health-interval-seconds": 1200,
    "check-health-steps": [
        {
            "id": "check-health",
            "sequence": 1,
            "name": "Check Health",
            "description": "Check on the health of the system",
            "action": {
                "type": "state-engine",
                "engine": "check-health"
            },
            "exit-events": [
                {
                    "condition": {
                        "is-done": true
                    }
                }
            ]
        }
    ],
    "check-ticket-health-sample-every": 5,
    "ready-tickets-join-sprint-at": "committed",
    "check-ticket-health-steps": [
        {
            "id": "check-ticket-health",
            "sequence": 1,
            "name": "Check Ticket Health",
            "description": "Check on the health of the ticketing system",
            "action": {
                "type": "state-engine",
                "engine": "check-ticket-health"
            },
            "exit-events": [
                {
                    "condition": {
                        "is-done": true
                    }
                }
            ]
        }
    ],
    "check-variation-appeal-interval-seconds": 900,
    "check-variation-appeal-steps": [
        {
            "id": "check-variation-appeal",
            "sequence": 1,
            "name": "Check Variation Appeal",
            "description": "Check on the appeal and progress relative to the other variations for this ticket",
            "action": {
                "type": "state-engine",
                "engine": "check-variation-appeal"
            },
            "exit-events": [
                {
                    "condition": {
                        "is-done": true
                    }
                }
            ]
        }
    ],
    "gap-resolution-steps": [
        {
            "id": "gap-resolution",
            "sequence": 1,
            "name": "Gap Resolution",
            "description": "Investigate the gap between the ticketing system's status and our status",
            "action": {
                "type": "state-engine",
                "engine": "investigate-gap"
            },
            "exit-events": [
                {
                    "condition": {
                        "is-done": true
                    }
                }
            ]
        }
    ],
    "steps": [
        {
            "id": "blocked-for-human",
            "sequence": 0,
            "area": "quarantine",
            "name": "Blocked for Human",
            "color": "#ff0000",
            "description": "A step failed or looped too many times; needs a human",
            "paired-ticket-system-status": "In Progress",
            "follow-return-to-state": true,
            "is-blocked-state": true,
            "action": {
                "type": "human",
                "instructions": "Resolve the block so work can continue on this ticket."
            },
            "exit-events": [
                {
                    "condition": {
                        "human-review": "Resolved"
                    },
                    "follow-return-to-state": true
                },
                {
                    "condition": {
                        "human-review": "Have AI Try Again to Unblock this Ticket"
                    },
                    "move-to-state": "blocked"
                }
            ],
            "warning-indicator": true
        },
        {
            "id": "blocked",
            "sequence": 0,
            "area": "quarantine",
            "name": "Blocked",
            "color": "#ffd700",
            "description": "A step failed or looped too many times; needs a human",
            "paired-ticket-system-status": "In Progress",
            "max-visits": 3,
            "on-max-visits": "blocked-for-human",
            "follow-return-to-state": true,
            "action": {
                "type": "state-engine",
                "engine": "blocked"
            },
            "exit-events": [
                {
                    "condition": {
                        "all": [
                            {
                                "is-done": true
                            },
                            {
                                "structured-output": {
                                    "landed": false
                                }
                            }
                        ]
                    },
                    "move-to-state": "blocked"
                },
                {
                    "condition": {
                        "is-done": true
                    },
                    "follow-return-to-state": true
                }
            ]
        },
        {
            "id": "self-healing",
            "sequence": 0,
            "area": "quarantine",
            "name": "Self Healing",
            "color": "#00bfff",
            "description": "A fix ticket self-healing raised: an agent fixes it, the harness restarts on the fix, the tickets it held resume",
            "paired-ticket-system-status": "In Progress",
            "return-to-state": "self-healing",
            "action": {
                "type": "state-engine",
                "engine": "self-healing-fix"
            },
            "exit-events": [
                {
                    "condition": {
                        "all": [
                            {
                                "is-done": true
                            },
                            {
                                "structured-output": {
                                    "is-fixed": true
                                }
                            }
                        ]
                    },
                    "move-to-state": "done"
                },
                {
                    "condition": {
                        "is-done": true
                    },
                    "move-to-state": "blocked-for-human"
                }
            ]
        },
        {
            "id": "backlog",
            "sequence": 1,
            "name": "Backlog",
            "description": "Work that still has an old status but was just committed to",
            "paired-ticket-system-status": "Backlog",
            "is-planning-stage": true,
            "action": {
                "type": "none"
            },
            "exit-events": [
                {
                    "condition": {
                        "always": true
                    },
                    "move-to-state": "committed"
                }
            ]
        },
        {
            "id": "committed",
            "sequence": 2,
            "name": "Committed",
            "description": "Queue of work ready to be started",
            "paired-ticket-system-status": "Committed",
            "is-planning-stage": true,
            "action": {
                "type": "none"
            },
            "exit-events": [
                {
                    "condition": {
                        "agent-needs-work": true
                    },
                    "move-to-state": "enrich-ac"
                }
            ]
        },
        {
            "id": "enrich-ac",
            "sequence": 3,
            "name": "Extract Acceptance Criteria",
            "description": "Extracting acceptance criteria from the ticket",
            "paired-ticket-system-status": "In Progress",
            "is-planning-stage": true,
            "max-visits": 3,
            "on-max-visits": "blocked",
            "return-to-state": "enrich-ac",
            "action": {
                "type": "prompt",
                "prompt": "enrich-ac",
                "agent-count": 1,
                "run-in-dev-container": false
            },
            "exit-events": [
                {
                    "condition": {
                        "all": [
                            {
                                "turn-complete": true
                            },
                            {
                                "structured-ticket-variation-array-check": {
                                    "member-name": "acceptance-criteria",
                                    "min-length": 1
                                }
                            }
                        ]
                    },
                    "move-to-state": "create-branch"
                }
            ]
        },
        {
            "id": "create-branch",
            "sequence": 4,
            "name": "Create Branch",
            "description": "Creating the branch for the ticket",
            "paired-ticket-system-status": "In Progress",
            "is-planning-stage": true,
            "max-visits": 3,
            "on-max-visits": "blocked",
            "return-to-state": "create-branch",
            "action": {
                "type": "script",
                "command": "./agent.sh code:create-branch {project} {ticket} {variation}"
            },
            "exit-events": [
                {
                    "condition": {
                        "exit-code": 0
                    },
                    "move-to-state": "create-worktree"
                },
                {
                    "condition": {
                        "not": {
                            "exit-code": 0
                        }
                    },
                    "move-to-state": "create-branch"
                }
            ]
        },
        {
            "id": "create-worktree",
            "sequence": 5,
            "name": "Create Worktree",
            "description": "Creating the worktree for the ticket",
            "paired-ticket-system-status": "In Progress",
            "is-planning-stage": true,
            "max-visits": 3,
            "on-max-visits": "blocked",
            "return-to-state": "create-worktree",
            "action": {
                "type": "script",
                "command": "./agent.sh code:create-worktree {project} {ticket} {variation}"
            },
            "exit-events": [
                {
                    "condition": {
                        "exit-code": 0
                    },
                    "move-to-state": "create-merge-request"
                },
                {
                    "condition": {
                        "not": {
                            "exit-code": 0
                        }
                    },
                    "move-to-state": "create-worktree"
                }
            ]
        },
        {
            "id": "create-merge-request",
            "sequence": 6,
            "name": "Create Merge Request",
            "description": "Opening the ticket's merge request as a draft",
            "paired-ticket-system-status": "In Progress",
            "is-planning-stage": true,
            "max-visits": 3,
            "on-max-visits": "blocked",
            "return-to-state": "create-merge-request",
            "action": {
                "type": "script",
                "command": "./agent.sh merge-request:create {project} {ticket} {variation}"
            },
            "exit-events": [
                {
                    "condition": {
                        "exit-code": 0
                    },
                    "move-to-state": "root-cause-analysis"
                },
                {
                    "condition": {
                        "not": {
                            "exit-code": 0
                        }
                    },
                    "move-to-state": "create-merge-request"
                }
            ]
        },
        {
            "id": "root-cause-analysis",
            "sequence": 7,
            "name": "Root Cause Analysis",
            "description": "Analyzing the root cause of issues",
            "paired-ticket-system-status": "In Progress",
            "is-planning-stage": true,
            "max-visits": 3,
            "on-max-visits": "blocked",
            "return-to-state": "root-cause-analysis",
