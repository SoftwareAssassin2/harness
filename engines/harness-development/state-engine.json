            },
            "exit-events": [
                {
                    "condition": {
                        "all": [
                            {
                                "turn-complete": true
                            },
                            {
                                "structured-output": {
                                    "is-approved": true
                                }
                            }
                        ]
                    },
                    "move-to-state": "write-execution-plan"
                },
                {
                    "condition": {
                        "all": [
                            {
                                "turn-complete": true
                            },
                            {
                                "structured-output": {
                                    "is-approved": false
                                }
                            }
                        ]
                    },
                    "move-to-state": "root-cause-analysis"
                }
            ]
