.DS_Store
node_modules/
*.lock
.data/
# Worktrees for branch work, kept out of the live checkout
/.worktrees/
# Live data, written by control and the TUI, all under data/ (ASS-55), is
# kept out of git (ASS-32): agents' session logs, chats, assignments, and every
# project's folder (project.json, .claude/, golden image, engines, work), shared
# as a preset bundle (harness:export-project), never in git (ASS-277). Only the
# agent names and the harness's shared settings are tracked.
/data/*
!/data/agent-names.json
!/data/harness.json
/archive/
# Off-board data, kept out of git
/src/off-board/
# Local Claude Code state (worktrees, locks, writes); the repo's skills are tracked (ASS-277)
/.claude/*
!/.claude/skills/
# Secrets and logs, never tracked (ASS-277)
.env*
*.pem
.npmrc
*credentials*.json
*.log
