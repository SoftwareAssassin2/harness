#!/bin/bash
# The harness's Docker credential helper on a GCP workstation (ASS-477),
# installed by workstation:setup as ~/harness/bin/docker-credential-harness,
# so that the agents' own pulls there (docker pull, docker compose up,
# devcontainer builds) reach the project's Artifact Registry as the
# workstation's service account. Found by ASS-472 on 2026-11-16: the owner's
# ~/.docker/config.json sends that host to the owner's gcloud credential
# helper, whose login on the workstation lapses every few hours under
# Workspace session control ("Reauthentication failed"), and the agents' pulls
# failed with it.
#
#   docker-credential-harness get              # Docker's credential-helper protocol: the host on stdin
#   docker-credential-harness store|erase|list # the rest of it: nothing kept, so nothing stored or listed
#   docker-credential-harness configure <host> # the harness's Docker config written for <host> (below)
#
# get prints {"ServerURL":<host>,"Username":"oauth2accesstoken","Secret":<token>}
# to Docker alone, the token the workstation's service account's, asked of the
# metadata server at every call (it keeps and renews the token itself; one
# lives about an hour): never one of the Mac's, never written anywhere, never
# logged — a failure says why without it.
#
# configure <host> writes the harness's own Docker config, ~/harness/docker
# (0700), which ~/harness/env makes DOCKER_CONFIG for the harness's sessions
# alone once it holds a config.json: the owner's ~/.docker/config.json as it
# is now (every other registry's auths, credsStore, the owner's credHelpers for
# other hosts, currentContext, proxies, …), but with credHelpers[<host>] this
# helper and any auths entry of <host>'s dropped; and a link to each other
# entry of ~/.docker (contexts, cli-plugins, buildx, …), so a context or a
# per-user plugin such as docker compose is found as in the owner's sessions
# (Docker reads them under DOCKER_CONFIG) — what Docker itself keeps there it
# keeps in the owner's folder, as before ASS-477. A link to an entry the owner
# removed is removed. The owner's ~/.docker is only read. Run at each setup
# and at each step's claim (wsv_start), so a change of the owner's config
# reaches the next step. Without an owner's config, or with one jq cannot
# read (said on stderr), the config holds the helper alone. Needs jq
# (~/harness/bin's, setup's).
#
# Tests stand a folder in for the workstation (test/support/fake-ssh.js):
# HARNESS_WS_METADATA_URL replaces the metadata server's
# (http://metadata.google.internal). A real ssh session never carries it.
set -uo pipefail
umask 077
metadata="${HARNESS_WS_METADATA_URL:-http://metadata.google.internal}"

case "${1-}" in
  get)
    IFS= read -r server || [[ -n "${server-}" ]]
    body="$(curl -fsS --max-time 10 -H 'Metadata-Flavor: Google' "$metadata/computeMetadata/v1/instance/service-accounts/default/token" 2>&1)" \
      || { echo "no token from the metadata server for the workstation's service account: $(printf '%s\n' "$body" | tail -n 1)"; exit 1; }
    token="$(sed -n 's/.*"access_token"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' <<< "$body")"
    [[ -n "$token" ]] || { echo "the metadata server's answer held no token for the workstation's service account"; exit 1; }
    server="${server//\\/\\\\}"; server="${server//\"/\\\"}"
    printf '{"ServerURL":"%s","Username":"oauth2accesstoken","Secret":"%s"}\n' "$server" "$token" ;;
  store) cat > /dev/null ;;   # docker login: nothing kept, every get asks the metadata server
  erase) cat > /dev/null ;;
  list) echo '{}' ;;
  configure)
    host="${2-}"
    [[ "$host" =~ ^[A-Za-z0-9.-]+(:[0-9]+)?$ ]] || { echo "usage: docker-credential-harness configure <registry host>" >&2; exit 1; }
    owner="$HOME/.docker" dir="$HOME/harness/docker"
    mkdir -p "$dir" && chmod 700 "$dir" || { echo "docker-credential-harness: $dir could not be made" >&2; exit 1; }
    base='{}'
    if [[ -f "$owner/config.json" ]]; then
      base="$(jq -c 'if type == "object" then . else error("not an object") end' "$owner/config.json" 2>&1)" \
        || { echo "docker-credential-harness: the owner's $owner/config.json could not be read ($(printf '%s\n' "$base" | tail -n 1)); the harness's Docker config holds the Artifact Registry helper alone" >&2; base='{}'; }
    fi
    tmp="$(mktemp "$dir/config.json.XXXXXX")" || exit 1
    jq --arg h "$host" '.credHelpers = ((.credHelpers // {}) + { ($h): "harness" })
      | if .auths then .auths |= with_entries(select(.key | sub("^https?://"; "") | sub("/.*$"; "") != $h)) else . end' <<< "$base" > "$tmp" \
      || { rm -f "$tmp"; echo "docker-credential-harness: the harness's Docker config could not be written" >&2; exit 1; }
    chmod 600 "$tmp"
    if [[ -f "$dir/config.json" ]] && cmp -s "$tmp" "$dir/config.json"; then rm -f "$tmp"; else mv -f "$tmp" "$dir/config.json"; fi
    for e in "$dir"/* "$dir"/.[!.]*; do   # links to entries the owner no longer has
      [[ -L "$e" && ! -e "$owner/${e##*/}" ]] && rm -f "$e"
    done
    for e in "$owner"/* "$owner"/.[!.]*; do
      [[ -e "$e" || -L "$e" ]] || continue
      n="${e##*/}"
      [[ "$n" != config.json && "$n" != config.json.* ]] || continue
      if [[ -L "$dir/$n" ]]; then [[ "$(readlink "$dir/$n")" == "$e" ]] || ln -sfn "$e" "$dir/$n"
      elif [[ ! -e "$dir/$n" ]]; then ln -s "$e" "$dir/$n"; fi   # one Docker made here itself is left alone
    done
    exit 0 ;;
  *) echo "usage: docker-credential-harness get|store|erase|list|configure <host>" >&2; exit 1 ;;
esac
